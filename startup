#!/bin/sh
set -e

cfg

# A failure here needs to crash the init because push will delete files from s3
# if allowed to proceed. `set -e` handles this.
s3cmd -c /.s3cfg sync "$S3_URL" "$S3_DIRECTORY"

if [ -f "$S3_DIRECTORY/.s3-empty-folders" ]; then
  cd "$S3_DIRECTORY"
  # The file contains a list of paths, one per line.
  # The grep is to sanitize the input.
  grep -oE '^[a-zA-Z0-9_-][a-zA-Z0-9_/-]*$' .s3-empty-folders | while IFS= read -r path; do
    mkdir -vp "$path"
  done
  cd /
fi

if [ -n "$USERID" ]; then
  # If GROUPID is not set, default to 1111.
  # This behavior should be documented.
  if [ -z "$GROUPID" ]; then
    export GROUPID=1111
  fi
  createuser
  chown -R "${USERID}:${GROUPID}" "$S3_DIRECTORY"
fi

if [ -n "$SLEEP_AFTER_PULL" ]; then
  sleep "$SLEEP_AFTER_PULL" || true
fi